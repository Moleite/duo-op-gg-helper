# --- Secrets: never committed ---
# Only file of local secrets. Template: .env.example, created by npm run setup.
.env

# Raw DOM captures: player names, notes, IP fragments. Only the version
# pseudonymized by scripts/clean-dom.mjs is committed (docs/architecture/dom-captures.md).
DOM/raw-*

# Probes and drafts
.tmp/

# Test dependencies
node_modules/

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
