{
	"manifest_version": 3,
	"name": "Duo.GG helper",
	"version": "1.0",
	"description": "Duo.GG helper",
	"author": "Moleite",
	"icons": {
		"16": "icon-16.png",
		"32": "icon-32.png",
		"48": "icon-48.png",
		"128": "icon-128.png"
	},
	"action": {
		"default_popup": "popup.html",
		"default_icon": "icon-48.png"
	},
	"permissions": [
		"scripting"
	],
    "host_permissions": ["<all_urls>"]
}