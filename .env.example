# .env.example - Template of .env, the only file of local secrets
#
# npm run setup copies this file to .env (git-ignored) when .env is missing.
# Fill .env, never this file: this one is committed.
# Variables and their role: docs/run/getting-started.md, section Variables.

# Connection string of your player login role (group duogg-user), created by
# db/create-role.sql. Not read by the extension: Chrome cannot read a file
# outside extension/. Paste it in the popup, Neon tab, in each browser.
# Kept here so that it lives in one known place.
DUOGG_NEON_URL=""

# Read-only connection string (role duogg_agent, group duogg-read), read by
# scripts/sql.mjs for the terminal and the agents (docs/database/sql-cli.md).
DUOGG_NEON_URL_READ=""
